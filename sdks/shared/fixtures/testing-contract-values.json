{
  "schema_version": 1,
  "scope": "accepted value:testing payload projections only; no remote methods or Mock runtime",
  "source_types": [
    "MockToolContext",
    "MockAgentStep field payloads",
    "StreamChunk field payloads"
  ],
  "limitations": [
    "Framework MockAgentStep/StreamChunk/MockToolContext have no serde codec; structural wrappers here are SDK WireValue representations of the accepted payloads, not reconstructed Rust Mock objects.",
    "Unknown variants preserve opaque wrappers; this does not accept a new API or promise variant-specific semantic validation.",
    "Invalid cases assert generic scalar/container lossless projection errors, not unspecified Mock-specific validators."
  ],
